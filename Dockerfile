# Use official lightweight Python image FROM python:3.11-slim # Set working directory inside container WORKDIR /app # Copy dependency definition and install COPY requirements.txt . RUN pip install --no-cache-dir -r requirements.txt # Copy source code COPY . . # Expose port 8080 for Cloud Run ENV PORT=8080 EXPOSE 8080 # Run Flask backend with Gunicorn server CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "8", "main:app"]
